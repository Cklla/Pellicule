<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- L'app n'a qu'un thème sombre définitif (voir PelliculeTheme côté Compose) : le thème
         Android sous-jacent doit l'être aussi, sinon les barres système (icônes, fond) gardent
         par défaut une apparence claire, invisible sur notre fond quasi-noir. -->
    <style name="Theme.Pellicule" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>
    </style>
</resources>
